GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
SECRET_KEY=change-this-to-any-long-random-string
# Optional
INTENT_CONF_THRESHOLD=0.7     # classifier confidence needed before Gemini is skipped
VOICE_RATE_LIMIT=20           # max voice requests per user per minute
# DB_PATH=/data/deepcal.db    # point at a persistent disk when deploying (SQLite file is lost on ephemeral hosts)
